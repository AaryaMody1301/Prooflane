# Copy to .env locally. Never commit .env or paste secrets into chat.
AI_MODE=sample
PAYMENT_MODE=simulation
PORT=8787
# Real AI: set AI_MODE=gemini. Use a free-tier project without billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Real sandbox: set PAYMENT_MODE=sandbox. These must be SANDBOX app keys.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
